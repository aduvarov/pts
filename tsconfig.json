{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2016",
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "esModuleInterop": true,
        "rootDir": "./src",
        "strictPropertyInitialization": false
    }
}
